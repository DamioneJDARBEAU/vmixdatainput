{
  "settings": {
    "website_url": "https://about.nla.gd/",
    "output_folder": "output",
    "state_file": "state.json",
    "overrides_file": "overrides.json",
    "vmix_api": {
      "enabled": true,
      "url": "http://127.0.0.1:8088/api/",
      "title_input": "LottoTitle",
      "date_field": "DateText.Text",
      "draw_field": "DrawID.Text"
    }
  },
  "date_format": {
    "pattern": "{day} {date} {month} {year}",
    "day_names": [
      "Mon.",
      "Tue.",
      "Wed.",
      "Thu.",
      "Fri.",
      "Sat.",
      "Sun."
    ],
    "month_names": [
      "Jan.",
      "Feb.",
      "Mar.",
      "Apr.",
      "May",
      "June",
      "July",
      "Aug.",
      "Sept.",
      "Oct.",
      "Nov.",
      "Dec."
    ]
  },
  "games": {
    "daily3_morning": {
      "name": "Daily 3 Morning",
      "preset_match": "Daily 3 Morning",
      "title_input": "LottoTitle",
      "increment": 1,
      "sources": [
        {
          "type": "web",
          "label_regex": "Daily\\s*3\\W{0,20}Morning",
          "window": 400
        },
        {
          "type": "sqlite",
          "database": "C:/EmailBlast/results.db",
          "query": "SELECT MAX(draw_number) FROM results WHERE game = ? AND period = ?",
          "params": [
            "Daily 3",
            "Morning"
          ]
        }
      ]
    },
