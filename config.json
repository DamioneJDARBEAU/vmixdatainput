{
  "settings": {
    "website_url": "https://about.nla.gd/",
    "supabase": {
      "url": "https://YOUR-PROJECT-ID.supabase.co",
      "key_file": "supabase_key.txt"
    },
    "output_folder": "output",
    "state_file": "state.json",
    "overrides_file": "overrides.json",
    "vmix_api": {
      "enabled": true,
      "url": "http://127.0.0.1:8088/api/",
      "title_input": "LottoTitle",
      "date_field": "Date.Text",
      "draw_field": "DRAW_ID.Text"
    }
  },
  "date_format": {
    "pattern": "{day} {date} {month} {year}",
    "day_names": [
      "Mon.",
      "Tue.",
      "Wed.",
      "Thu.",
      "Fri.",
      "Sat.",
      "Sun."
    ],
    "month_names": [
      "Jan.",
      "Feb.",
      "Mar.",
      "Apr.",
      "May",
      "June",
      "July",
      "Aug.",
      "Sept.",
      "Oct.",
      "Nov.",
      "Dec."
    ]
  },
  "games": {
    "pick3_morning": {
      "name": "Pick 3 Morning",
      "preset_match": [
        "Daily Pick 3 Morning",
        "Pick 3 Morning",
        "Daily 3 Morning"
      ],
      "title_input": "LottoTitle",
      "increment": 1,
      "sources": [
        {
          "type": "supabase_slot",
          "table": "daily_results",
          "draw_column": "pick3_draw_no",
          "date_column": "draw_date",
          "period_column": "period",
          "period": "mid_morning",
          "periods": [
            "mid_morning",
            "midday",
            "mid_afternoon",
            "evening"
          ]
        },
        {
          "type": "web",
          "label_regex": "(?:Daily\\s*(?:Pick\\s*)?|Pick\\s*)3\\W{0,20}(?:Mid[\\s-]*)?Morning",
          "window": 400
        }
      ]
    },
